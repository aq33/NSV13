//caves papers

/obj/item/paper/crumpled/awaymissions/caves/unsafe_area
	default_raw_text = "<center><b>OSTRZEŻENIE</center></b><br><br><center>Większość tego obszaru za tym punktem uznaje się za „niebezpieczną”. Na południe stąd jest posterunek, gdzie możesz się zorientować i w razie potrzeby zejść niżej. Podróżowanie w grupach jest MOCNO zalecane, to cholerstwo tam na dole może być śmiertelnie niebezpieczne, jeśli jesteś sam.</center>"

/obj/item/paper/fluff/awaymissions/caves/omega
	name = "Subject Omega Notes"
	default_raw_text = "<b><center>Notatki z badań</b></center><br><br><center>Obiekt nie reaguje na większość interakcji, odmawia odejścia z kątów i odwrócenia się twarzą do któregokolwiek z naukowców. Przy każdej obserwacji obiekt przemieszcza się między dwoma tylnymi kątami. Z wnętrza celi słychać dziwne buczenie, które zdaje się pochodzić od samego obiektu; potrzebne są dalsze badania, by to potwierdzić lub wykluczyć.</center>"

/obj/item/paper/fluff/awaymissions/caves/magma
	default_raw_text = "<center> Górnictwo tu na dole to piekło, czuć żar magmy bez względu na to, jak gruby jest skafander. Warunki są ledwo znośne: nieprzespane noce i koszmarne warunki pracy. Ruda może tu być bogata, ale straciliśmy już kilku ludzi przez przesuwające się uskoki; Bóg wie, ile jeszcze, zanim wszystko się zawali i pochłonie nas wszystkich.</center>"

/obj/item/paper/fluff/awaymissions/caves/work_notice
	name = "work notice"
	default_raw_text = "<center><b>Informacje o przetrwaniu dla górników</b></center><br><br><center>Jaskinie to bezlitosne miejsce, jedyne, czym możesz się w nich posłużyć, to zapasy z twojej szafki i własny spryt. Podczas wydobycia trzymaj się w grupach i staraj się niszczyć legowiska potworów, zanim cię przytłoczą. Praca jest niebezpieczna, ale urobek jest dobry, więc zapamiętaj te informacje, a może wszyscy wrócimy do domu żywi.</center>"

/obj/item/paper/fluff/awaymissions/caves/shipment_notice
	name = "shipment notice"
	default_raw_text = "<center>Mieliśmy dostać dostawę tych specjalnych karabinów laserowych i parę granatów do walki z tutejszą fauną, ale od tygodni nie mamy wieści od karawany, która miała to przywieźć. W tej chwili możemy tylko zakładać, że padli ofiarą któregoś z gniazd potworów albo te kretyny zdołały wpaść do lawy. No to tyle z tej dostawy.</center>"

/obj/item/paper/fluff/awaymissions/caves/safety_notice
	name = "safety notice"
	default_raw_text = "<center>Część górników zaczęła rozstawiać miny na niższych poziomach kopalni, żeby trzymać potwory na dystans. To chyba nie najmądrzejszy pomysł w takiej jaskini, ale chłopaki chichoczą przy każdym odległym wybuchu, więc chyba działa </center>"

/obj/item/paper/fluff/awaymissions/caves/shipment_receipt
	name = "Shipment Receipt"
	default_raw_text = "<center><b>USŁUGI KARAWANOWE</b></center><br><center><i>Jakość od 2205 roku</i></center><br><br><center><b>ZAWARTOŚĆ PRZESYŁKI:</b></center><br><br>4 karabiny rozpryskowe<br>6 granatów<br>1 karabin laserowy<br>1 dmuchana lalka"

/obj/item/paper/fluff/awaymissions/caves/mech_notice
	name = "NOTICE!! paper"
	default_raw_text = "<center><b>UWAGA!!</center></b><br><br><center>Choć w mechu możesz wydawać się niezniszczalny, pamiętaj: TO GÓWNO NIE JEST ODPORNE NA LAWĘ!! Chłopaki już stracili dwa ostatnie na złom, bo jakiś debil myślał, że może sobie przejść przez dolne jeziora, jakby nigdy nic. To, że w ogóle wrócił, nie stopiwszy się z resztkami mecha, to istny cud. Są zbudowane, by wytrzymywać ekstremalne gorąco, a nie by być na nie ODPORNE!</center><br><br><i>Zespół robotyki</i>"
