//	crashedship items

/obj/item/paper/fluff/ruins/crashedship/scribbled
	name = "scribbled note"
	default_raw_text = "Następna osoba, która weźmie jeden z moich śrubokrętów, zostanie nim dźgnięta. Są MOJE. - Całuski, Madsen"


/obj/item/paper/fluff/ruins/crashedship/captains_log
	name = "Captain's log entry"
	default_raw_text = "Nie jestem naukowcem, ale sądząc po konstrukcji i podzespołach, to chyba jakiś teleporter. Ta rzecz będzie warta kupę kasy dla odpowiedniego człowieka. Chłopaki są podekscytowani i mają do tego pełne prawo, więc pozwoliłem im napocząć tę skrzynkę piwa, którą mamy. Normalnie bym na to nie pozwolił, ale to czas świętowania! Parę drinków przecież nikomu nie zaszkodzi."

/obj/item/paper/fluff/ruins/crashedship/old_diary
	name = "Old Diary"
	default_raw_text = "DROGI PAMIĘTNIKU: No więc lecieliśmy swoją zwykłą trasą, kiedy kapitan mówi, że łapiemy dziwne sygnały z jakiejś zapadłej planety. Madsen chciał trzymać kurs, ale to nie on jest kapitanem, więc zboczyliśmy, żeby to sprawdzić. Po drodze było mnóstwo skał, ale dolecieliśmy na planetę bez problemu. Znaleźliśmy duży, wypasiony obóz bez nikogo i ten wielki metalowy pączek z pieczątkami NT w samym środku. Skrzynkę piwa też. Kapitan uważa, że możemy to opchnąć jakiemuś kupcowi w Syndykacie. Ingram mówi, że to przynosi pecha i że ktoś przyjdzie tego szukać, ale to brzmi jak lepsza kasa niż sprzedawanie zepsutego mięsa firmom od suszonej wołowiny."

