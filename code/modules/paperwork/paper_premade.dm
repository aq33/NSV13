/obj/item/paper/fluff/sop
	name = "paper- 'Standard Operating Procedure'"
	default_raw_text = "Poziomy alarmowe:<BR>\nNiebieski - sytuacja awaryjna<BR>\n\t1. Wywołany przez pożar<BR>\n\t2. Wywołany ręcznie<BR>\n\tDziałanie:<BR>\n\t\tZamknij wszystkie drzwi przeciwpożarowe. Można je otworzyć tylko po zresetowaniu alarmu<BR>\nCzerwony - wyrzut/autodestrukcja<BR>\n\t1. Wywołany przez komputer sterujący modułem.<BR>\n\tDziałanie:<BR>\n\t\tPo upływie określonego czasu moduł zostanie całkowicie wyrzucony.<BR>\n<BR>\nInstrukcja konserwacji silnika:<BR>\n\tWyłącz układy zapłonowe:<BR>\n\tWłącz zasilanie wewnętrzne<BR>\n\tWłącz matrycę równowagi orbitalnej<BR>\n\tUsuń z obszaru lotne ciecze<BR>\n\tZałóż kombinezon przeciwpożarowy<BR>\n<BR>\n\tPotem<BR>\n\t\tPrzejdź dekontaminację<BR>\n\t\tZgłoś się do lekarza<BR>\n<BR>\nProcedura w laboratorium toksyn:<BR>\n\tZawsze noś maskę gazową<BR>\n\tWeź butlę z tlenem.<BR>\n\tWłącz wewnętrzną atmosferę<BR>\n<BR>\n\tPotem<BR>\n\t\tPrzejdź dekontaminację<BR>\n\t\tZgłoś się do lekarza<BR>\n<BR>\nProcedura na wypadek katastrofy:<BR>\n\tPożar:<BR>\n\t\tWłącz alarm przeciwpożarowy sektora.<BR>\n\t\tPrzejdź w bezpieczne miejsce.<BR>\n\t\tWeź kombinezon przeciwpożarowy<BR>\n\t\tPotem:<BR>\n\t\t\tOceń szkody<BR>\n\t\t\tNapraw uszkodzenia<BR>\n\t\t\tW razie potrzeby ewakuuj się<BR>\n\tDeszcz meteorów:<BR>\n\t\tWłącz alarm przeciwpożarowy<BR>\n\t\tPrzejdź na tył statku<BR>\n\t\tPotem<BR>\n\t\t\tNapraw uszkodzenia<BR>\n\t\t\tW razie potrzeby ewakuuj się<BR>\n\tPrzypadkowe wejście w atmosferę:<BR>\n\t\tWłącz alarmy przeciwpożarowe na dziobie statku.<BR>\n\t\tPrzenieś materiały lotne w miejsce ognioodporne!<BR>\n\t\tWeź kombinezon przeciwpożarowy.<BR>\n\t\tPozostań w bezpiecznym miejscu do przybycia statku ratunkowego.<BR>\n<BR>\n\t\tJeśli statek nie przybędzie -<BR>\n\t\t\tewakuuj się w pobliskie bezpieczne miejsce!"

