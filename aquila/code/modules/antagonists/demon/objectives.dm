/datum/objective/demon
	completed = TRUE

/datum/objective/demon/gluttony
	explanation_text = "Pochłoń tyle jedzenia, ile to dla Ciebie możliwe. Nie pożeraj i nie zabijaj ludzi, chyba że celowo na Ciebie polują lub próbują Cię powstrzymać."

/datum/objective/demon/greed
	explanation_text = "Osiągnij bogactwa, których inni będą Ci zazdrościć. Nie zabijaj dla zdobycia majątku, ranienie jest dozwolone."

/datum/objective/demon/wrath
	explanation_text = "Spraw jak najwięcej cierpienia innym. Nie urządzaj rzezi, by szybko mordować - przedłużaj cierpienie pojedynczych osób. Pamiętaj, że agonia jednej osoby jest warta więcej niż błyskawiczna śmierć wielu."

/datum/objective/demon/envy
	explanation_text = "Przejmij tożsamość najpotężniejszej osoby na pokładzie. Unikaj, jak tylko możesz, śmierci osób, które nie są Twoim celem."

/datum/objective/demon/pride
	explanation_text = "Stań się Potęgą zarówno w rozpoznawalności, jak i w sile, dla jak największej liczby osób. Popełnianie przestępstw raczej obniży Twoją popularność."
