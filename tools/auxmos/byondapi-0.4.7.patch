@@ -64,7 +64,19 @@ pub struct InitFunc(pub fn() -> ());
 #[macro_export]
 macro_rules! byond_string {
     ($s:literal) => {{
-        static STRING_ID: ::std::sync::OnceLock<u32> = ::std::sync::OnceLock::new();
-        *STRING_ID.get_or_init(|| $crate::byond_string::str_id_of($s).unwrap())
+        // AQUILA PATCH: (generation << 32) | id, refreshed when the world changes.
+        static STRING_ID: ::std::sync::atomic::AtomicU64 = ::std::sync::atomic::AtomicU64::new(0);
+        let generation = $crate::byond_string::string_cache_generation();
+        let cached = STRING_ID.load(::std::sync::atomic::Ordering::Relaxed);
+        if (cached >> 32) as u32 == generation {
+            cached as u32
+        } else {
+            let id = $crate::byond_string::str_id_of($s).unwrap();
+            STRING_ID.store(
+                ((generation as u64) << 32) | id as u64,
+                ::std::sync::atomic::Ordering::Relaxed,
+            );
+            id
+        }
     }};
 }
