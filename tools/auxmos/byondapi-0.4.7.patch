     Ok(res)
 }
+
+// AQUILA PATCH: auxmos pins itself so it survives world reboots, but string ids belong to the world.
+// byond_string! caches ids per generation; invalidate_string_cache() starts a new one for a new world.
+static GENERATION: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(1);
+
+#[doc(hidden)]
+pub fn string_cache_generation() -> u32 {
+    GENERATION.load(std::sync::atomic::Ordering::Acquire)
+}
+
+/// Forgets every id cached by `byond_string!`. Call it when a new world starts in the same process.
+pub fn invalidate_string_cache() {
+    GENERATION.fetch_add(1, std::sync::atomic::Ordering::AcqRel);
+}
diff --git a/src/lib.rs b/src/lib.rs
