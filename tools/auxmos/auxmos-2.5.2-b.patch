+//! AQUILA PATCH: surviving world reboots.
+//!
+//! BYOND unloads every call_ext library when a world reboots or is stopped, but the process (and the
+//! rayon worker threads auxmos started) keeps running. Those threads are parked inside this DLL's code,
+//! so the next time one of them wakes up it jumps into unmapped memory and DreamDaemon crashes
+//! ("auxmos.dll_unloaded", 0xC0000005).
+//!
+//! Instead the library pins itself in memory the first time it is used: it then stays loaded until the
+//! DreamDaemon process exits, and the next world reuses it (and its thread pool). Because statics now
+//! outlive the world, the world calls `/proc/__auxmos_reset` as it ends (`/world/Reboot()`, `/world/Del()`),
+//! which throws away everything that belonged to it, so the next world finds the library as if freshly loaded.
+//! (Resetting at the start of the next world is too late: gas mixtures already exist during global init.)
+
+use byondapi::prelude::*;
+
+#[cfg(windows)]
+#[byondapi::init]
+pub fn pin_library() {
+	const GET_MODULE_HANDLE_EX_FLAG_PIN: u32 = 0x1;
+	const GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS: u32 = 0x4;
+
+	#[link(name = "kernel32")]
+	extern "system" {
+		fn GetModuleHandleExW(flags: u32, module_name: *const u16, module: *mut *mut core::ffi::c_void) -> i32;
+	}
+
+	let mut module = core::ptr::null_mut();
+	// Any address inside this DLL identifies it; a pinned module ignores every later FreeLibrary.
+	unsafe {
+		GetModuleHandleExW(
+			GET_MODULE_HANDLE_EX_FLAG_PIN | GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+			pin_library as *const u16,
+			&mut module,
+		);
+	}
+}
+
+#[cfg(unix)]
+#[byondapi::init]
+pub fn pin_library() {
+	// RTLD_NODELETE on an already loaded object marks it as never unloaded.
+	const RTLD_NOW: i32 = 0x2;
+	const RTLD_NOLOAD: i32 = 0x4;
+	const RTLD_NODELETE: i32 = 0x1000;
+
+	#[repr(C)]
+	struct DlInfo {
+		dli_fname: *const core::ffi::c_char,
+		dli_fbase: *mut core::ffi::c_void,
+		dli_sname: *const core::ffi::c_char,
+		dli_saddr: *mut core::ffi::c_void,
+	}
+
+	extern "C" {
+		fn dladdr(addr: *const core::ffi::c_void, info: *mut DlInfo) -> i32;
+		fn dlopen(filename: *const core::ffi::c_char, flags: i32) -> *mut core::ffi::c_void;
+	}
+
+	unsafe {
+		let mut info: DlInfo = core::mem::zeroed();
+		if dladdr(pin_library as *const core::ffi::c_void, &mut info) != 0 && !info.dli_fname.is_null() {
+			dlopen(info.dli_fname, RTLD_NOW | RTLD_NOLOAD | RTLD_NODELETE);
+		}
+	}
+}
+
+/// Call when a world ends, after which it must not touch atmos again.
+/// Throws away all of its state so the next world in this process starts clean.
+#[byondapi::bind("/proc/__auxmos_reset")]
+fn reset_hook() {
+	#[cfg(feature = "turf_processing")]
+	crate::turfs::wait_for_tasks();
+
+	// String ids, ByondValues and object refs all belong to the old world. ByondValue has no Drop,
+	// so throwing the old ones away does not touch the new world's refcounts.
+	byondapi::byond_string::invalidate_string_cache();
+	auxcallback::clean_callbacks();
+
+	crate::gas::initialize_gases();
+	crate::gas::types::reset_gas_info();
+	crate::reaction::clear_reaction_values();
+
+	#[cfg(feature = "turf_processing")]
+	{
+		crate::turfs::initialize_turfs();
+		crate::turfs::groups::flush_groups_channel();
+		#[cfg(feature = "katmos")]
+		crate::turfs::katmos::flush_equalize_channel();
+	}
+
+	Ok(ByondValue::null())
+}
